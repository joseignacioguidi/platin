# --- API (apps/api) ---
# Runtime connection (Neon: pooled connection string)
DATABASE_URL=postgresql://platin:platin@localhost:5432/platin
# Direct connection, used by `prisma migrate` (Neon: direct connection string)
DIRECT_URL=postgresql://platin:platin@localhost:5432/platin
# Database used by the API e2e tests (created and migrated by the test setup)
TEST_DATABASE_URL=postgresql://platin:platin@localhost:5432/platin_test
PORT=3000
# Signs the 15-minute access tokens. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
# Secret mixed into the refresh token hash. Generate with: openssl rand -base64 48
REFRESH_TOKEN_PEPPER=change-me-refresh-pepper-at-least-32-characters
# Header added by Vercel's rewrite. Leave empty to disable the check (local, VPS).
ORIGIN_SECRET=
# App origin, allowed by CORS only for /api/v1/health
APP_ORIGIN=http://localhost:4200
RATES_BASE_URL=https://dolarapi.com
# Simulated "today" (YYYY-MM-DD) for local testing. Never set in production.
CLOCK_TODAY=

# --- Web build (Vercel) ---
# Direct Render URL, used by the front to wake the server via /api/v1/health
API_DIRECT_URL=
