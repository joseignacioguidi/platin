# --- API (apps/api) ---
# Runtime connection (Neon: pooled connection string)
DATABASE_URL=postgresql://platin:platin@localhost:5432/platin
# Direct connection, used by `prisma migrate` (Neon: direct connection string)
DIRECT_URL=postgresql://platin:platin@localhost:5432/platin
# Database used by the API e2e tests (created and migrated by the test setup)
TEST_DATABASE_URL=postgresql://platin:platin@localhost:5432/platin_test
# PORT is set by the host (Render); the API defaults to 3000. Not set here because Nx
# loads this file into every task and the Angular dev server would also take it.
# Signs the 15-minute access tokens. Generate with: openssl rand -base64 48
# In production the API refuses these change-me placeholders and repeated characters.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
# Secret mixed into the refresh token hash. Generate with: openssl rand -base64 48
REFRESH_TOKEN_PEPPER=change-me-refresh-pepper-at-least-32-characters
# Header added by Vercel's rewrite. Required in production; leave empty locally.
ORIGIN_SECRET=
# Production without Vercel in front (VPS): set to true to run without ORIGIN_SECRET.
ALLOW_DIRECT_ACCESS=
# Header with the real client IP that the edge proxy always overwrites (Vercel:
# x-vercel-forwarded-for). Rate limiting prefers it. Leave empty without such a proxy.
CLIENT_IP_HEADER=
# Proxies that append to X-Forwarded-For in front of the API (Vercel + Cloudflare + Render = 4
# hops from the client entry; local = 0). Fallback when CLIENT_IP_HEADER is missing.
# The rate limit uses the IP that many hops from the right; the rest is set by the client.
# Required in production; empty means 0 elsewhere.
TRUST_PROXY_HOPS=
# Temporary: log the client IP the API sees on each login, to confirm TRUST_PROXY_HOPS.
LOG_CLIENT_IP=
# App origin, allowed by CORS only for /api/v1/health
APP_ORIGIN=http://localhost:4200
# Comma-separated emails that become administrators when they sign in (ADM-01)
ADMIN_EMAILS=
RATES_BASE_URL=https://dolarapi.com
# Public URL of the web app (Vercel URL in Render). OAuth redirect URIs and the redirects after
# signing in are built from it, never from the request's host.
PUBLIC_APP_URL=http://localhost:4200
# Signs the oauth_tx cookie of a sign-in in progress. Generate with: openssl rand -base64 48
OAUTH_COOKIE_SECRET=
# Google sign-in (AUTH-06). Leave empty to disable it (the button doesn't show).
# Redirect URI to register in Google Cloud: <PUBLIC_APP_URL>/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Simulated "today" (YYYY-MM-DD) for local testing. Never set in production.
CLOCK_TODAY=

# --- Web build (Vercel) ---
# Direct Render URL, used by the front to wake the server via /api/v1/health
API_DIRECT_URL=
