# ElevenLabs, for `pnpm voiceover`. Copy to .env (never committed) and fill in.
# API key: elevenlabs.io › Developers › API Keys (needs the Text to Speech permission).
ELEVENLABS_API_KEY=
# Voice ID: Voices › pick a voice › "Copy voice ID". Prefer an Argentine Spanish voice.
ELEVENLABS_VOICE_ID=

# Optional (defaults in scripts/voiceover.mjs)
ELEVENLABS_MODEL=eleven_multilingual_v2
# Only for models that take it, like eleven_flash_v2_5 or eleven_v3: es
ELEVENLABS_LANGUAGE=
# 0–1. Higher = steadier, lower = more expressive.
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0.15
# 0.7–1.2
ELEVENLABS_SPEED=1
