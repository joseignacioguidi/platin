generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------
enum Currency {
  ARS
  USD
}

enum RateType {
  OFICIAL
  MEP
  BLUE
}

enum AccountType {
  CASH
  BANK
  WALLET
  SAVINGS
  INVESTMENT
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TxType {
  INCOME
  EXPENSE
  ADJUSTMENT
}

enum TxStatus {
  PENDING
  CONFIRMED
}

enum TxOrigin {
  MANUAL
  FIXED
  ADJUSTMENT
}

enum FixedKind {
  INCOME
  EXPENSE
}

enum StatementStatus {
  OPEN
  CLOSED
  PARTIALLY_PAID
  PAID
}

// ---------- User and session ----------
model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String
  name          String?
  baseCurrency  Currency  @default(ARS)
  valuationRate RateType  @default(MEP)
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens RefreshToken[]
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  transfers     Transfer[]
  creditCards   CreditCard[]
  statements    CardStatement[]
  cardCharges   CardCharge[]
  fixedItems    FixedItem[]
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  family    String    @db.Uuid // to detect reuse of a rotated token
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([family])
}

// ---------- Accounts and categories ----------
model Account {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @db.Uuid
  name              String
  type              AccountType
  currency          Currency
  initialBalance    Decimal     @default(0) @db.Decimal(18, 2)
  includeInNetWorth Boolean     @default(true)
  color             String? // design token name (transfer, savings, ...)
  archivedAt        DateTime?
  createdAt         DateTime    @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  transfersOut Transfer[]    @relation("TransferFrom")
  transfersIn  Transfer[]    @relation("TransferTo")
  defaultFor   CreditCard[]
  fixedItems   FixedItem[]

  @@index([userId])
}

model Category {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  name       String
  kind       CategoryKind
  icon       String // Lucide icon name
  color      String // design token name
  parentId   String?      @db.Uuid
  archivedAt DateTime?

  user         User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  parent       Category?             @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]            @relation("CategoryParent")
  transactions Transaction[]
  cardCharges  CardCharge[]
  adjustments  StatementAdjustment[]
  fixedItems   FixedItem[]

  @@unique([userId, kind, name])
}

// ---------- Transactions and transfers ----------
model Transaction {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  accountId   String    @db.Uuid
  categoryId  String?   @db.Uuid
  type        TxType
  status      TxStatus  @default(CONFIRMED)
  origin      TxOrigin  @default(MANUAL)
  amount      Decimal   @db.Decimal(18, 2) // account currency; signed only for ADJUSTMENT (ADR 0004)
  currency    Currency
  rateToBase  Decimal   @db.Decimal(18, 6) // frozen when recorded
  baseAmount  Decimal   @db.Decimal(18, 2)
  date        DateTime  @db.Date
  description String?
  fixedId     String?   @db.Uuid
  fixedPeriod DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  account  Account    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category Category?  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  fixed    FixedItem? @relation(fields: [fixedId], references: [id], onDelete: Restrict)

  @@unique([fixedId, fixedPeriod]) // fixed items idempotency
  @@index([userId, date])
  @@index([accountId, date])
}

// Moves money between accounts or pays a card statement: exactly one destination
// (check constraint in the migration SQL).
model Transfer {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  fromAccountId String   @db.Uuid
  toAccountId   String?  @db.Uuid
  statementId   String?  @db.Uuid
  amountOut     Decimal  @db.Decimal(18, 2) // origin account currency
  amountIn      Decimal  @db.Decimal(18, 2) // destination currency
  currencyIn    Currency // for a statement payment: which part it pays
  date          DateTime @db.Date
  description   String?
  createdAt     DateTime @default(now())

  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  fromAccount Account        @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account?       @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  statement   CardStatement? @relation(fields: [statementId], references: [id], onDelete: Restrict)

  @@index([userId, date])
}

// ---------- Cards ----------
model CreditCard {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @db.Uuid
  name                    String
  issuer                  String?
  last4                   String?   @db.Char(4)
  creditLimit             Decimal?  @db.Decimal(18, 2)
  closingDay              Int // 1-31
  dueDay                  Int // 1-31
  defaultPaymentAccountId String?   @db.Uuid
  archivedAt              DateTime?
  createdAt               DateTime  @default(now())

  user                  User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  defaultPaymentAccount Account?        @relation(fields: [defaultPaymentAccountId], references: [id], onDelete: Restrict)
  statements            CardStatement[]
  charges               CardCharge[]
  fixedItems            FixedItem[]

  @@index([userId])
}

model CardStatement {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  cardId          String          @db.Uuid
  period          DateTime        @db.Date // month of the closing
  closingDate     DateTime        @db.Date
  dueDate         DateTime        @db.Date
  datesOverridden Boolean         @default(false)
  status          StatementStatus @default(OPEN)
  bankTotalArs    Decimal?        @db.Decimal(18, 2) // entered when closing
  bankTotalUsd    Decimal?        @db.Decimal(18, 2)

  user         User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  card         CreditCard            @relation(fields: [cardId], references: [id], onDelete: Restrict)
  installments Installment[]
  adjustments  StatementAdjustment[]
  payments     Transfer[]

  @@unique([cardId, period])
  @@index([userId, dueDate])
}

model CardCharge {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  cardId            String    @db.Uuid
  categoryId        String    @db.Uuid
  date              DateTime  @db.Date
  description       String
  totalAmount       Decimal   @db.Decimal(18, 2)
  currency          Currency
  installmentsCount Int       @default(1)
  startInstallment  Int       @default(1) // "voy por la k de N"
  fixedId           String?   @db.Uuid // card subscription (TAR-09)
  fixedPeriod       DateTime? @db.Date
  createdAt         DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  card         CreditCard    @relation(fields: [cardId], references: [id], onDelete: Restrict)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  installments Installment[]

  @@unique([fixedId, fixedPeriod])
  @@index([userId, date])
}

model Installment {
  id          String   @id @default(uuid()) @db.Uuid
  chargeId    String   @db.Uuid
  statementId String   @db.Uuid
  number      Int
  amount      Decimal  @db.Decimal(18, 2)
  currency    Currency

  charge    CardCharge    @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  statement CardStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@unique([chargeId, number])
  @@index([statementId])
}

// Difference between the calculated total and the bank's: interest, taxes, stamps.
model StatementAdjustment {
  id          String   @id @default(uuid()) @db.Uuid
  statementId String   @db.Uuid
  categoryId  String   @db.Uuid
  amount      Decimal  @db.Decimal(18, 2) // can be negative (a credit)
  currency    Currency
  description String?

  statement CardStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  category  Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
}

// ---------- Fixed items ----------
model FixedItem {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  kind                FixedKind
  name                String
  categoryId          String    @db.Uuid
  accountId           String?   @db.Uuid // one of the two
  cardId              String?   @db.Uuid
  currency            Currency
  intervalMonths      Int       @default(1) // 1 monthly, 12 yearly
  dayOfMonth          Int
  startPeriod         DateTime  @db.Date
  endPeriod           DateTime? @db.Date
  pausedAt            DateTime?
  lastGeneratedPeriod DateTime? @db.Date

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  card         CreditCard?   @relation(fields: [cardId], references: [id], onDelete: Restrict)
  amounts      FixedAmount[]
  transactions Transaction[]

  @@index([userId])
}

model FixedAmount {
  id            String   @id @default(uuid()) @db.Uuid
  fixedId       String   @db.Uuid
  amount        Decimal  @db.Decimal(18, 2)
  effectiveFrom DateTime @db.Date // period it applies from

  fixed FixedItem @relation(fields: [fixedId], references: [id], onDelete: Cascade)

  @@unique([fixedId, effectiveFrom])
}

// ---------- Exchange rates (global, no userId) ----------
model ExchangeRate {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @db.Date
  type      RateType
  buy       Decimal  @db.Decimal(18, 6) // ARS per 1 USD
  sell      Decimal  @db.Decimal(18, 6)
  source    String
  fetchedAt DateTime @default(now())

  @@unique([date, type])
}
