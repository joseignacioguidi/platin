generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------
enum Currency {
  ARS
  USD
}

enum RateType {
  OFICIAL
  MEP
  BLUE
}

enum AccountKind {
  BANK
  WALLET
  CASH
  BROKER
}

enum PocketKind {
  AVAILABLE
  SAVINGS
  INVESTMENT
}

// MUTUAL_FUND includes Superfondos
enum InstrumentType {
  CEDEAR
  STOCK
  MUTUAL_FUND
  TERM_DEPOSIT
  CRYPTO
  OTHER
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TxType {
  INCOME
  EXPENSE
  ADJUSTMENT
  YIELD
}

enum TxStatus {
  PENDING
  CONFIRMED
}

enum TxOrigin {
  MANUAL
  FIXED
  ADJUSTMENT
  VALUATION
}

enum FixedKind {
  INCOME
  EXPENSE
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  CANCELLED
}

enum StatementStatus {
  OPEN
  CLOSED
  PARTIALLY_PAID
  PAID
}

// ---------- User and session ----------
enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  passwordHash  String
  name          String?
  baseCurrency  Currency   @default(ARS)
  valuationRate RateType   @default(MEP)
  lastSyncedAt  DateTime?
  role          Role       @default(USER) // granted by ADMIN_EMAILS, never from the app
  status        UserStatus @default(ACTIVE)
  lastSeenAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  refreshTokens RefreshToken[]
  accounts      Account[]
  pockets       Pocket[]
  categories    Category[]
  transactions  Transaction[]
  transfers     Transfer[]
  creditCards   CreditCard[]
  statements    CardStatement[]
  cardCharges   CardCharge[]
  fixedItems    FixedItem[]
  goals         Goal[]
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  family    String    @db.Uuid // to detect reuse of a rotated token
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([family])
}

// ---------- Accounts and pockets ----------
// The institution or place: Mercado Pago, Santander, cash, a broker.
model Account {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  name       String
  kind       AccountKind
  color      String? // design token name
  sortOrder  Int         @default(0)
  archivedAt DateTime?
  createdAt  DateTime    @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  pockets Pocket[]

  @@unique([userId, name])
  @@index([userId])
}

// Money set apart inside an account, in a single currency.
model Pocket {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid // denormalized to filter without a join
  accountId         String          @db.Uuid
  name              String // "Disponible", "Auto", "CEDEARs"
  kind              PocketKind
  currency          Currency
  instrument        InstrumentType? // only when kind = INVESTMENT (check constraint)
  initialBalance    Decimal         @default(0) @db.Decimal(18, 2)
  includeInNetWorth Boolean         @default(true)
  sortOrder         Int             @default(0)
  archivedAt        DateTime?
  createdAt         DateTime        @default(now())

  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  account      Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  transfersOut Transfer[]        @relation("TransferFrom")
  transfersIn  Transfer[]        @relation("TransferTo")
  defaultFor   CreditCard[]
  fixedItems   FixedItem[]
  goalLinks    GoalPocket[]
  valuations   PocketValuation[]

  @@unique([accountId, name, currency])
  @@index([userId])
}

// Value of an investment pocket entered by hand; it creates a YIELD movement.
model PocketValuation {
  id            String   @id @default(uuid()) @db.Uuid
  pocketId      String   @db.Uuid
  date          DateTime @db.Date
  value         Decimal  @db.Decimal(18, 2)
  transactionId String?  @unique @db.Uuid // the YIELD it created (null when the difference was 0)
  createdAt     DateTime @default(now())

  pocket      Pocket       @relation(fields: [pocketId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([pocketId, date])
}

model Category {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  name       String
  kind       CategoryKind
  icon       String // Lucide icon name
  color      String // design token name
  parentId   String?      @db.Uuid
  systemKey  String? // "ADJUSTMENT" | "YIELD": not editable nor archivable
  archivedAt DateTime?

  user         User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  parent       Category?             @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]            @relation("CategoryParent")
  transactions Transaction[]
  cardCharges  CardCharge[]
  adjustments  StatementAdjustment[]
  fixedItems   FixedItem[]

  @@unique([userId, kind, name])
  @@unique([userId, systemKey])
}

// ---------- Transactions and transfers ----------
model Transaction {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  pocketId    String    @db.Uuid
  categoryId  String?   @db.Uuid
  type        TxType
  status      TxStatus  @default(CONFIRMED)
  origin      TxOrigin  @default(MANUAL)
  amount      Decimal   @db.Decimal(18, 2) // signed only for ADJUSTMENT and YIELD (ADR 0004)
  currency    Currency // = the pocket's currency
  rateToBase  Decimal   @db.Decimal(18, 6) // frozen when recorded
  baseAmount  Decimal   @db.Decimal(18, 2)
  date        DateTime  @db.Date
  description String?
  fixedId     String?   @db.Uuid
  fixedPeriod DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  pocket    Pocket           @relation(fields: [pocketId], references: [id], onDelete: Restrict)
  category  Category?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  fixed     FixedItem?       @relation(fields: [fixedId], references: [id], onDelete: Restrict)
  valuation PocketValuation?

  @@unique([fixedId, fixedPeriod]) // fixed items idempotency
  @@index([userId, date])
  @@index([pocketId, date])
}

// Moves money between pockets (set apart, invest, redeem, between accounts, buy dollars)
// or pays a card statement: exactly one destination (check constraint in the SQL).
model Transfer {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  fromPocketId String   @db.Uuid
  toPocketId   String?  @db.Uuid
  statementId  String?  @db.Uuid
  amountOut    Decimal  @db.Decimal(18, 2) // origin pocket currency
  amountIn     Decimal  @db.Decimal(18, 2) // destination currency
  currencyIn   Currency // for a statement payment: which part it pays
  date         DateTime @db.Date
  description  String?
  createdAt    DateTime @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  fromPocket Pocket         @relation("TransferFrom", fields: [fromPocketId], references: [id], onDelete: Restrict)
  toPocket   Pocket?        @relation("TransferTo", fields: [toPocketId], references: [id], onDelete: Restrict)
  statement  CardStatement? @relation(fields: [statementId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([fromPocketId])
  @@index([toPocketId])
}

// ---------- Cards ----------
model CreditCard {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @db.Uuid
  name                   String
  issuer                 String?
  last4                  String?   @db.Char(4)
  creditLimit            Decimal?  @db.Decimal(18, 2)
  closingDay             Int // 1-31
  dueDay                 Int // 1-31
  defaultPaymentPocketId String?   @db.Uuid
  archivedAt             DateTime?
  createdAt              DateTime  @default(now())

  user                 User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  defaultPaymentPocket Pocket?         @relation(fields: [defaultPaymentPocketId], references: [id], onDelete: Restrict)
  statements           CardStatement[]
  charges              CardCharge[]
  fixedItems           FixedItem[]

  @@index([userId])
}

model CardStatement {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  cardId          String          @db.Uuid
  period          DateTime        @db.Date // month of the closing
  closingDate     DateTime        @db.Date
  dueDate         DateTime        @db.Date
  datesOverridden Boolean         @default(false)
  status          StatementStatus @default(OPEN)
  bankTotalArs    Decimal?        @db.Decimal(18, 2) // entered when closing
  bankTotalUsd    Decimal?        @db.Decimal(18, 2)

  user         User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  card         CreditCard            @relation(fields: [cardId], references: [id], onDelete: Restrict)
  installments Installment[]
  adjustments  StatementAdjustment[]
  payments     Transfer[]

  @@unique([cardId, period])
  @@index([userId, dueDate])
}

model CardCharge {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  cardId            String    @db.Uuid
  categoryId        String    @db.Uuid
  date              DateTime  @db.Date
  description       String
  totalAmount       Decimal   @db.Decimal(18, 2)
  currency          Currency
  installmentsCount Int       @default(1)
  startInstallment  Int       @default(1) // "voy por la k de N"
  fixedId           String?   @db.Uuid // card subscription (TAR-09)
  fixedPeriod       DateTime? @db.Date
  createdAt         DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  card         CreditCard    @relation(fields: [cardId], references: [id], onDelete: Restrict)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  installments Installment[]

  @@unique([fixedId, fixedPeriod])
  @@index([userId, date])
}

model Installment {
  id          String   @id @default(uuid()) @db.Uuid
  chargeId    String   @db.Uuid
  statementId String   @db.Uuid
  number      Int
  amount      Decimal  @db.Decimal(18, 2)
  currency    Currency

  charge    CardCharge    @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  statement CardStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@unique([chargeId, number])
  @@index([statementId])
}

// Difference between the calculated total and the bank's: interest, taxes, stamps.
model StatementAdjustment {
  id          String   @id @default(uuid()) @db.Uuid
  statementId String   @db.Uuid
  categoryId  String   @db.Uuid
  amount      Decimal  @db.Decimal(18, 2) // can be negative (a credit)
  currency    Currency
  description String?

  statement CardStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  category  Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
}

// ---------- Fixed items ----------
model FixedItem {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  kind                FixedKind
  name                String
  categoryId          String    @db.Uuid
  pocketId            String?   @db.Uuid // one of the two (check constraint)
  cardId              String?   @db.Uuid
  currency            Currency
  intervalMonths      Int       @default(1) // 1 monthly, 12 yearly
  dayOfMonth          Int
  startPeriod         DateTime  @db.Date
  endPeriod           DateTime? @db.Date
  pausedAt            DateTime?
  lastGeneratedPeriod DateTime? @db.Date

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  pocket       Pocket?       @relation(fields: [pocketId], references: [id], onDelete: Restrict)
  card         CreditCard?   @relation(fields: [cardId], references: [id], onDelete: Restrict)
  amounts      FixedAmount[]
  transactions Transaction[]

  @@index([userId])
}

model FixedAmount {
  id            String   @id @default(uuid()) @db.Uuid
  fixedId       String   @db.Uuid
  amount        Decimal  @db.Decimal(18, 2)
  effectiveFrom DateTime @db.Date // period it applies from

  fixed FixedItem @relation(fields: [fixedId], references: [id], onDelete: Cascade)

  @@unique([fixedId, effectiveFrom])
}

// ---------- Exchange rates (global, no userId) ----------
model ExchangeRate {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @db.Date
  type      RateType
  buy       Decimal  @db.Decimal(18, 6) // ARS per 1 USD
  sell      Decimal  @db.Decimal(18, 6)
  source    String
  fetchedAt DateTime @default(now())

  @@unique([date, type])
}

// ---------- Goals ----------
model Goal {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  name         String
  targetAmount Decimal    @db.Decimal(18, 2)
  currency     Currency
  targetPeriod DateTime   @db.Date
  status       GoalStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  pockets GoalPocket[]

  @@index([userId])
}

// The pockets that measure a goal. To split money among goals, one pocket per goal.
model GoalPocket {
  goalId   String @db.Uuid
  pocketId String @db.Uuid

  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  pocket Pocket @relation(fields: [pocketId], references: [id], onDelete: Cascade)

  @@id([goalId, pocketId])
}

// ---------- Plans ----------
enum PlanSource {
  DEFAULT
  ADMIN
  REQUEST
  PAYMENT // reserved for real billing
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Plan {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique // "free", "pro"
  name        String
  description String
  priceArs    Decimal?  @db.Decimal(18, 2) // reference only, never charged
  limits      Json // validated with Zod: { maxAccounts, maxPockets, maxCards, maxGoals, maxFixed: int | null; investments: boolean }
  isDefault   Boolean   @default(false) // exactly one (partial unique index in the migration)
  isPublic    Boolean   @default(true) // listed on the public plans page
  sortOrder   Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  userPlans UserPlan[]
  requests  PlanRequest[]
}

// Plan history of each user; the one in force is the latest that has not expired.
model UserPlan {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  planId    String     @db.Uuid
  source    PlanSource
  startsAt  DateTime   @default(now())
  endsAt    DateTime? // first instant it no longer applies
  grantedBy String?    @db.Uuid // admin who assigned it

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, startsAt])
}

model PlanRequest {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  planId    String        @db.Uuid
  message   String?
  status    RequestStatus @default(PENDING)
  decidedBy String?       @db.Uuid
  decidedAt DateTime?
  createdAt DateTime      @default(now())

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([userId])
}

// ---------- Administration ----------
// Global configuration: one row per key, each value validated by its Zod schema in libs/contracts.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid
}

// Every admin action that changes something. No foreign keys: it outlives deleted users.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @db.Uuid
  action       String // "user.suspend", "setting.update"...
  targetUserId String?  @db.Uuid
  payload      Json // before and after; never financial data
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId])
}

// One row per user and day with activity: feeds "active in 7 and 30 days".
model ActivityDay {
  userId String   @db.Uuid
  date   DateTime @db.Date

  @@id([userId, date])
  @@index([date])
}
